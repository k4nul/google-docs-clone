SNAPSHOT_NIKIDB_PATH=./data/snapshots.nikidb
SNAPSHOT_NODB_PATH=./data/snapshots.nodb
SNAPSHOT_PARITY_DB_PATH=./data/snapshots.parity_db
SNAPSHOT_PICKLEDB_PATH=./data/snapshots.pickledb
SNAPSHOT_MICROKV_PATH=./data/snapshots_microkv
SNAPSHOT_REDB_PATH=./data/snapshots.redb
SNAPSHOT_RSKEY_PATH=./data/snapshots.rskey
SNAPSHOT_READB_PATH=./data/snapshots.readb
SNAPSHOT_RUSTLITE_PATH=./data/snapshots.rustlite
SNAPSHOT_CANOPYDB_PATH=./data/snapshots.canopydb
SNAPSHOT_CAVES_PATH=./data/snapshots.caves
SNAPSHOT_CKYDB_PATH=./data/snapshots.ckydb
SNAPSHOT_SCDB_PATH=./data/snapshots.scdb
SNAPSHOT_SURREALKV_PATH=./data/snapshots.surrealkv
SNAPSHOT_SLED_PATH=./data/snapshots.sled
SNAPSHOT_RUSTBREAK_PATH=./data/snapshots.rustbreak
SNAPSHOT_YEDB_PATH=./data/snapshots.yedb
SNAPSHOT_BTREE_STORE_PATH=./data/snapshots.btree_store
SNAPSHOT_SIAMESDB_PATH=./data/snapshots.siamesedb
SNAPSHOT_STRUCTSY_PATH=./data/snapshots.structsy
SNAPSHOT_ABYSSINIANDB_PATH=./data/snapshots.abyssiniandb
SNAPSHOT_AETERNUSDB_PATH=./data/snapshots.aeternusdb
SNAPSHOT_THUNDERDB_PATH=./data/snapshots.thunderdb
SNAPSHOT_TINYBASE_PATH=./data/snapshots.tinybase
SNAPSHOT_DBLITE_PATH=./data/snapshots.dblite
SNAPSHOT_DBLESS_PATH=./data/snapshots.dbless
SNAPSHOT_SANAKIRJA_PATH=./data/snapshots.sanakirja
SNAPSHOT_SNAILDB_PATH=./data/snapshots.snaildb
SNAPSHOT_TINYKV_PATH=./data/snapshots.tinykv.json
SNAPSHOT_YAKV_PATH=./data/snapshots.yakv
SNAPSHOT_SABERDB_PATH=./data/snapshots.saberdb.json
SNAPSHOT_JSONDB_PATH=./data/snapshots.jsondb.json
SNAPSHOT_S3_REGION=us-east-1
SNAPSHOT_S3_PREFIX=snapshots/
SNAPSHOT_S3_TIMEOUT_SECS=5
SNAPSHOT_S3_PATH_STYLE=true
SNAPSHOT_MANAGED_TIMEOUT_SECS=5
ROOM_LOCATOR=local
ROOM_COORDINATOR=noop
ROOM_COORDINATOR_STATE_DIR=./data/room-coordinator
ROOM_COORDINATOR_SQLITE_PATH=./data/room-coordinator.sqlite3
ROOM_COORDINATOR_HEARTBEAT_INTERVAL_SECS=10
ROOM_COORDINATOR_LEASE_TTL_SECS=30
ROOM_COORDINATION_MANAGED_TIMEOUT_SECS=5
NODE_ID=local-node
NODE_BASE_URL=http://127.0.0.1:4000
# ROOM_LOCATOR=file uses ROOM_COORDINATOR_STATE_DIR as a readable ownership state directory.
# ROOM_LOCATOR=sqlite and ROOM_COORDINATOR=sqlite share ROOM_COORDINATOR_SQLITE_PATH.
# ROOM_LOCATOR=managed and ROOM_COORDINATOR=managed share ROOM_COORDINATION_MANAGED_BASE_URL.
# SNAPSHOT_S3_ENDPOINT=http://127.0.0.1:9000
# SNAPSHOT_S3_BUCKET=backend-snapshots
# SNAPSHOT_S3_ACCESS_KEY_ID=minioadmin
# SNAPSHOT_S3_SECRET_ACCESS_KEY=minioadmin
# SNAPSHOT_S3_SESSION_TOKEN=
# ROOM_COORDINATION_MANAGED_BASE_URL=http://127.0.0.1:9000/coordination
# ROOM_COORDINATION_MANAGED_AUTH_TOKEN=managed-coordination-token
# SNAPSHOT_MANAGED_BASE_URL=http://127.0.0.1:9100/durability
# SNAPSHOT_MANAGED_AUTH_TOKEN=managed-snapshot-token
# ROOM_OWNER_HINTS_PATH=./config/room-owner-hints.json
