HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=backend=debug,tower_http=info
API_TOKEN=dev-admin-token
SNAPSHOT_STORE=memory
SNAPSHOT_DIR=./data/snapshots
SNAPSHOT_SQLITE_PATH=./data/snapshots.sqlite3
SNAPSHOT_HEED_PATH=./data/snapshots.heed
SNAPSHOT_JAMMDB_PATH=./data/snapshots.jammdb
SNAPSHOT_FJALL_PATH=./data/snapshots.fjall
SNAPSHOT_PERSY_PATH=./data/snapshots.persy
SNAPSHOT_REDB_PATH=./data/snapshots.redb
SNAPSHOT_SLED_PATH=./data/snapshots.sled
SNAPSHOT_S3_REGION=us-east-1
SNAPSHOT_S3_PREFIX=snapshots/
SNAPSHOT_S3_TIMEOUT_SECS=5
SNAPSHOT_S3_PATH_STYLE=true
SNAPSHOT_MANAGED_TIMEOUT_SECS=5
ROOM_LOCATOR=local
ROOM_COORDINATOR=noop
ROOM_COORDINATOR_STATE_DIR=./data/room-coordinator
ROOM_COORDINATOR_SQLITE_PATH=./data/room-coordinator.sqlite3
ROOM_COORDINATOR_HEARTBEAT_INTERVAL_SECS=10
ROOM_COORDINATOR_LEASE_TTL_SECS=30
ROOM_COORDINATION_MANAGED_TIMEOUT_SECS=5
NODE_ID=local-node
NODE_BASE_URL=http://127.0.0.1:4000
# ROOM_LOCATOR=file uses ROOM_COORDINATOR_STATE_DIR as a readable ownership state directory.
# ROOM_LOCATOR=sqlite and ROOM_COORDINATOR=sqlite share ROOM_COORDINATOR_SQLITE_PATH.
# ROOM_LOCATOR=managed and ROOM_COORDINATOR=managed share ROOM_COORDINATION_MANAGED_BASE_URL.
# SNAPSHOT_S3_ENDPOINT=http://127.0.0.1:9000
# SNAPSHOT_S3_BUCKET=backend-snapshots
# SNAPSHOT_S3_ACCESS_KEY_ID=minioadmin
# SNAPSHOT_S3_SECRET_ACCESS_KEY=minioadmin
# SNAPSHOT_S3_SESSION_TOKEN=
# ROOM_COORDINATION_MANAGED_BASE_URL=http://127.0.0.1:9000/coordination
# ROOM_COORDINATION_MANAGED_AUTH_TOKEN=managed-coordination-token
# SNAPSHOT_MANAGED_BASE_URL=http://127.0.0.1:9100/durability
# SNAPSHOT_MANAGED_AUTH_TOKEN=managed-snapshot-token
# ROOM_OWNER_HINTS_PATH=./config/room-owner-hints.json
