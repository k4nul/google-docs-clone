HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=backend=debug,tower_http=info
API_TOKEN=dev-admin-token
SNAPSHOT_STORE=memory
SNAPSHOT_DIR=./data/snapshots
SNAPSHOT_FLASH_KV_PATH=./data/snapshots.flash_kv
SNAPSHOT_SIMPLE_DB_PATH=./data/snapshots.simple_db
